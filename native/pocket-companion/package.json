{
  "name": "great-marketrealm-pocket-companion-native",
  "version": "0.2.0",
  "private": true,
  "description": "Native client workshop for The Great MarketRealm Pocket Companion.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "cap:sync": "npx cap sync",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios --packagemanager SPM",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "android:prepare": "node scripts/prepare-android.mjs",
    "android:open": "npm run build && npx cap sync android && npx cap open android"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "vite": "^7.0.0"
  },
  "engines": { "node": ">=22" }
}
