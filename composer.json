{
    "name": "marketrealmstudios/great-marketrealm-companion",
    "description": "A modular Dungeons & Dragons companion platform for the Great Marketrealm.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "authors": [
        {
            "name": "Marketrealm Studios"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "GreatMarketrealmCompanion\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GreatMarketrealmCompanion\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
